# Postgres (Neon free tier for dev; VPS-local in production)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/tenderradar?sslmode=require

# Raw document archive (append-only, gzipped). Move to R2 when >20GB.
STORAGE_DIR=storage/raw

# Crawler identity — rule §8.1: identify the bot with a real contact email.
# The contact email below is appended automatically; don't inline it here.
CRAWLER_USER_AGENT=TenderRadarBot/0.1
CRAWLER_CONTACT_EMAIL=you@example.com

# Politeness. Never make these aggressive against a government host (§8.7).
CRAWLER_REQUEST_DELAY_SEC=1.0
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_TIMEOUT_SEC=60

LOG_LEVEL=INFO
