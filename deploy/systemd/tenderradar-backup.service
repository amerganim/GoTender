[Unit]
Description=TenderRadar database backup
After=postgresql.service

[Service]
Type=oneshot
User=tenderradar
Group=tenderradar
WorkingDirectory=/opt/tenderradar
EnvironmentFile=/opt/tenderradar/.env
ExecStart=/opt/tenderradar/deploy/backup.sh

Nice=19
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tenderradar/backups
